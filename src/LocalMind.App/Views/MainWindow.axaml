<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalMind.App.ViewModels"
        xmlns:services="using:LocalMind.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="LocalMind.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000" Height="650"
        MinWidth="640" MinHeight="400"
        Icon="/Assets/app-icon.ico"
        Title="LocalMind"
        DragDrop.AllowDrop="True">
    
    <!-- Гарячі клавіші на рівні вікна — працюють з будь-якої сторінки (A-13). Meta — Cmd на macOS. -->
    <Window.KeyBindings>
      <KeyBinding Gesture="Ctrl+K" Command="{Binding FocusSearchCommand}" />
      <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
      <KeyBinding Gesture="Meta+K" Command="{Binding FocusSearchCommand}" />
      <KeyBinding Gesture="Meta+F" Command="{Binding FocusSearchCommand}" />
    </Window.KeyBindings>
    
    <!-- DataContext задає App.axaml.cs: MainViewModel береться з DI. -->
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Стан ядра (CoreStatus) і необроблені помилки: видно на будь-якій сторінці. -->
      <StackPanel Grid.Row="0">
        <Border IsVisible="{Binding HasNotice}" Padding="16,8"
                Background="{DynamicResource Lm.Brush.BackgroundSecondary}"
                BorderBrush="{DynamicResource Lm.Brush.Warning}" BorderThickness="0,0,0,2">
          <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" AutomationProperties.Name="Стан ядра: проблема" />
        </Border>
        <Border IsVisible="{Binding IsRestartRequired}" Padding="16,8"
                Background="{DynamicResource Lm.Brush.BackgroundSecondary}"
                BorderBrush="{DynamicResource Lm.Brush.Warning}" BorderThickness="0,0,0,2">
          <TextBlock Text="{x:Static services:AppRestartState.Message}" TextWrapping="Wrap" AutomationProperties.Name="Потрібен перезапуск" />
        </Border>
        <Border IsVisible="{Binding HasUnhandledError}" Padding="16,8"
                Background="{DynamicResource Lm.Brush.BackgroundSecondary}"
                BorderBrush="{DynamicResource Lm.Brush.Error}" BorderThickness="0,0,0,2">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="error" Text="{Binding UnhandledErrorText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" AutomationProperties.Name="Необроблена помилка" />
            <Button Grid.Column="1" Content="Закрити" Command="{Binding DismissUnhandledErrorCommand}" />
          </Grid>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="220,*">
        <DockPanel Margin="12,16,12,12">
          <TextBlock DockPanel.Dock="Top" Text="LocalMind" FontWeight="SemiBold" Margin="12,0,12,20" />
          <ListBox ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   SelectionMode="AlwaysSelected"
                   Background="Transparent"
                   BorderThickness="0"
                   AutomationProperties.Name="Навігація">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <TextBlock Text="{Binding Title}" Margin="4,2" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- ViewLocator створює View за типом VM; DataContext передається ContentControl. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Margin="24" />
      </Grid>

      <!-- Рядок стану: стан ядра (коли індексації немає або з ядром проблема), прогрес і «Скасувати». -->
      <Border Grid.Row="2" Padding="16,8" BorderBrush="{DynamicResource Lm.Brush.Border}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding StatusText}" AutomationProperties.Name="Стан ядра">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="Indexing.IsIdle" />
                <Binding Path="HasStatusProblem" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,200,*" ColumnSpacing="12" VerticalAlignment="Center"
                IsVisible="{Binding Indexing.IsIndexing}">
            <TextBlock Text="{Binding Indexing.ProgressText}" VerticalAlignment="Center"
                       AutomationProperties.Name="Прогрес індексації" />
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Indexing.Fraction}"
                         Foreground="{DynamicResource Lm.Brush.Accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Indexing.CurrentFileName}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Indexing.Progress.CurrentFile}" />
          </Grid>

          <Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                  Content="{Binding Indexing.CancelText}" Command="{Binding Indexing.CancelCommand}"
                  IsVisible="{Binding Indexing.IsIndexing}" AutomationProperties.Name="Скасувати індексацію" />
        </Grid>
      </Border>

      <!-- Підказка під час перетягування файлів у вікно (A-11): поверх усього вікна, кліки не перехоплює. -->
      <Border Grid.RowSpan="3" IsVisible="{Binding IsDragOver}" IsHitTestVisible="False" Margin="12"
              Background="{DynamicResource Lm.Brush.BackgroundSecondary}"
              BorderBrush="{DynamicResource Lm.Brush.Accent}" BorderThickness="2"
              CornerRadius="{DynamicResource Lm.Radius.Card}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="Відпустіть, щоб додати до бібліотеки" HorizontalAlignment="Center"
                     FontSize="{DynamicResource Lm.FontSize.Heading}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Папка стане відстежуваною; для файла додається його папка." />
        </StackPanel>
      </Border>
    </Grid>

</Window>
