<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalMind.App.ViewModels"
             xmlns:sys="using:System"
             x:Class="LocalMind.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <!-- Кольори й відступи — з теми застосунку (Styles/*.axaml): класи muted, error, card, accent. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Бібліотека" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Додати папку" Command="{Binding AddFolderCommand}" />
        <Button Content="Пересканувати" Command="{Binding RescanCommand}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               TextWrapping="Wrap" AutomationProperties.Name="Помилка бібліотеки" />

    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="Папки" FontWeight="SemiBold" />
      <TextBlock Classes="muted" IsVisible="{Binding !HasFolders}" TextWrapping="Wrap"
                 Text="Папок ще немає. Натисніть «Додати папку» — вона одразу піде на індексацію." />
      <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
               IsVisible="{Binding HasFolders}" MaxHeight="160"
               Background="Transparent" BorderThickness="0"
               AutomationProperties.Name="Відстежувані папки">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="sys:String">
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="Прибрати папку" Command="{Binding RequestRemoveFolderCommand}" IsVisible="{Binding HasFolders}" />
    </StackPanel>

    <!-- Підтвердження прямо на сторінці: в Avalonia немає вбудованого діалогу «Так / Ні». -->
    <Border Grid.Row="3" Classes="card" IsVisible="{Binding IsConfirmingRemoval}">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap"
                   Text="{Binding FolderPendingRemoval, StringFormat='Прибрати папку «{0}» з бібліотеки? Її документи зникнуть із пошуку. Самі файли на диску не видаляються.'}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Прибрати" Command="{Binding ConfirmRemoveFolderCommand}" />
          <Button Content="Скасувати" Command="{Binding CancelRemoveFolderCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding SummaryText}" FontWeight="SemiBold" />

    <Grid Grid.Row="5">
      <TextBlock Classes="muted" Text="Документів поки немає." IsVisible="{Binding !HasDocuments}" />
      <ListBox ItemsSource="{Binding Documents}" IsVisible="{Binding HasDocuments}"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="Документи бібліотеки">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryDocumentItem">
            <StackPanel Spacing="4" Margin="4,6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes.error="{Binding IsError}" />
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Path}" />
              <TextBlock Classes="muted" Text="{Binding ChunkCount, StringFormat='Фрагментів: {0}'}" />
              <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding IsError}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>