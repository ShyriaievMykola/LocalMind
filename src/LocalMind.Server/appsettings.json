{
  "ConnectionStrings": {
    "Server": "Data Source=localmind-server.db"
  },
  "Jwt": {
    "Issuer": "LocalMind.Server",
    "Audience": "LocalMind",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "SessionMaxLifetime": "30.00:00:00"
  },
  "Storage": {
    "RootPath": "backups",
    "MaxBackupBytes": 104857600,
    "MaxBackupsPerUser": 20,
    "MaxTotalBytesPerUser": 1073741824
  },
  "Audit": {
    "RetentionDays": 180
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindow": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
