<Project Sdk="Microsoft.NET.Sdk">

  <!-- Консольна утиліта: index / search / eval. Прототип тижнів 1–2 і eval-раннер для експериментів. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>localmind</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalMind.Core\LocalMind.Core.csproj" />
    <ProjectReference Include="..\LocalMind.Search\LocalMind.Search.csproj" />
  </ItemGroup>

</Project>
