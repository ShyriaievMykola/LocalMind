# Скопіюйте в deploy/.env (цей файл у Git не потрапляє) і заповніть.

# Ключ підпису JWT: base64 щонайменше з 32 байтів. Згенерувати:
#   openssl rand -base64 48
# Не публікуйте його й не комітьте; зміна ключа розлогінить усіх користувачів.
LOCALMIND_JWT_KEY=

# Початковий адміністратор (необов'язково, але без нього адмін-ендпоінтів не буде). Обидва поля разом;
# пароль — щонайменше 12 символів. Після першого запуску пароль можна прибрати з файла.
# LOCALMIND_ADMIN_EMAIL=
# LOCALMIND_ADMIN_PASSWORD=

# Необов'язкове:
# LOCALMIND_PORT=8080
# LOCALMIND_PROXY_NETWORK=172.16.0.0/12
# Дозволені імена хоста через «;»; localhost для healthcheck додається автоматично.
# LOCALMIND_ALLOWED_HOSTS=backup.example.com
